---
const contactInfo = [
  {
    icon: '📧',
    label: 'Email',
    value: 'danileogutierrez@gmail.com',
    href: 'mailto:danileogutierrez@gmail.com',
  },
  {
    icon: '💻',
    label: 'GitHub',
    value: 'github.com/DLGO2003',
    href: 'https://github.com/DLGO2003',
  },
  {
    icon: '📍',
    label: 'Ubicación',
    value: 'Pereira, Colombia',
    href: null,
  },
];
---

<section id="contacto" class="py-24 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <p class="text-primary font-medium mb-2" data-i18n="contact.badge">Contacto</p>
      <h2 class="section-title" data-i18n="contact.title">¿Trabajamos juntos?</h2>
      <p class="section-subtitle mx-auto" data-i18n="contact.subtitle">
        Estoy abierto a nuevas oportunidades, colaboraciones y proyectos interesantes.
        ¡No dudes en escribirme!
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Contact Info -->
      <div class="space-y-8">
        <div>
          <h3 class="text-xl font-semibold text-text-primary mb-6" data-i18n="contact.info.title">Información de contacto</h3>
          <div class="space-y-4">
            {
              contactInfo.map((info) =>
                info.href ? (
                  <a
                    href={info.href}
                    target={info.href.startsWith('http') ? '_blank' : undefined}
                    rel={info.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="flex items-center gap-4 p-4 card hover:border-primary/50"
                  >
                    <span class="text-2xl">{info.icon}</span>
                    <div>
                      <p class="text-text-muted text-sm">{info.label}</p>
                      <p class="text-text-primary font-medium">{info.value}</p>
                    </div>
                  </a>
                ) : (
                  <div class="flex items-center gap-4 p-4 card">
                    <span class="text-2xl">{info.icon}</span>
                    <div>
                      <p class="text-text-muted text-sm">{info.label}</p>
                      <p class="text-text-primary font-medium">{info.value}</p>
                    </div>
                  </div>
                )
              )
            }
          </div>
        </div>

        <!-- Extra CTA -->
        <div class="card bg-gradient-to-br from-primary/10 to-primary/5 border-primary/20">
          <h4 class="text-lg font-semibold text-text-primary mb-2" data-i18n="contact.cta.title">¿Prefieres escribir directamente?</h4>
          <p class="text-text-secondary text-sm mb-4" data-i18n="contact.cta.desc">
            Envíame un email y te responderé lo antes posible.
          </p>
          <a href="mailto:danileogutierrez@gmail.com" class="btn-primary">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span data-i18n="contact.cta.btn">Enviar email</span>
          </a>
        </div>
      </div>

      <!-- Contact Form -->
      <div>
        <h3 class="text-xl font-semibold text-text-primary mb-6" data-i18n="contact.form.title">Envíame un mensaje</h3>
        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-6"
        >
          <!-- Web3Forms Access Key -->
          <input type="hidden" name="access_key" value="f0edaafc-6727-4cea-9d97-f4eef37ac95c" />
          <input type="hidden" name="subject" value="Nuevo mensaje desde el portafolio" />
          <input type="hidden" name="from_name" value="Portafolio - Daniel Gutierrez" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />
          <div>
            <label for="name" class="block text-sm font-medium text-text-secondary mb-2" data-i18n="contact.form.name">
              Nombre completo
            </label>
            <input
              type="text"
              name="name"
              id="name"
              required
              data-i18n-placeholder="contact.form.namePlaceholder"
              class="w-full px-4 py-3 bg-bg-card border border-border rounded-lg text-text-primary placeholder-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors"
              placeholder="Tu nombre"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-text-secondary mb-2" data-i18n="contact.form.email">
              Correo electrónico
            </label>
            <input
              type="email"
              name="email"
              id="email"
              required
              data-i18n-placeholder="contact.form.emailPlaceholder"
              class="w-full px-4 py-3 bg-bg-card border border-border rounded-lg text-text-primary placeholder-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors"
              placeholder="tu@email.com"
            />
          </div>

          <div>
            <label for="subject" class="block text-sm font-medium text-text-secondary mb-2" data-i18n="contact.form.subject">
              Asunto
            </label>
            <input
              type="text"
              name="subject"
              id="subject"
              required
              data-i18n-placeholder="contact.form.subjectPlaceholder"
              class="w-full px-4 py-3 bg-bg-card border border-border rounded-lg text-text-primary placeholder-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors"
              placeholder="¿De qué quieres hablar?"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-text-secondary mb-2" data-i18n="contact.form.message">
              Mensaje
            </label>
            <textarea
              name="message"
              id="message"
              rows="5"
              required
              data-i18n-placeholder="contact.form.messagePlaceholder"
              class="w-full px-4 py-3 bg-bg-card border border-border rounded-lg text-text-primary placeholder-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors resize-none"
              placeholder="Escribe tu mensaje aquí..."
            ></textarea>
          </div>

          <button type="submit" class="btn-primary w-full justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            <span data-i18n="contact.form.submit">Enviar mensaje</span>
          </button>

          <!-- Success Message -->
          <div id="form-success" class="hidden p-4 bg-success/10 border border-success/30 rounded-lg text-center">
            <p class="text-success font-medium">✅ ¡Mensaje enviado con éxito!</p>
            <p class="text-text-muted text-sm mt-1">Te responderé lo antes posible.</p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector('form[action="https://api.web3forms.com/submit"]') as HTMLFormElement;
  const successMsg = document.getElementById('form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitBtn.innerHTML;

    // Loading state
    submitBtn.disabled = true;
    submitBtn.innerHTML = '⏳ Enviando...';

    try {
      const formData = new FormData(form);
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData,
      });

      const result = await response.json();

      if (result.success) {
        form.reset();
        successMsg?.classList.remove('hidden');
        setTimeout(() => successMsg?.classList.add('hidden'), 5000);
      } else {
        alert('Hubo un error al enviar el mensaje. Por favor intenta de nuevo.');
      }
    } catch {
      alert('Hubo un error al enviar el mensaje. Por favor intenta de nuevo.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalText;
    }
  });
</script>
