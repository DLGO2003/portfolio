---
const skillCategories = [
  {
    name: 'Frontend',
    icon: '🎨',
    skills: ['HTML5', 'CSS3', 'JavaScript', 'TypeScript', 'React', 'Astro', 'Tailwind CSS', 'Bootstrap'],
  },
  {
    name: 'Backend',
    icon: '⚙️',
    skills: ['Node.js', 'Python', 'Express.js', 'REST APIs', 'GraphQL', 'PHP', 'Laravel', 'Django'],
  },
  {
    name: 'Bases de Datos',
    icon: '🗄️',
    skills: ['MySQL', 'PostgreSQL', 'MongoDB', 'Redis'],
  },
  {
    name: 'DevOps & Herramientas',
    icon: '🛠️',
    skills: ['Git', 'Docker', 'Linux', 'CI/CD', 'AWS', 'GitHub Actions', 'Laravel Cloud', 'Buquets', 'Web Hosting & VPS', 'Gestión de DNS / Dominios'],
  },
  {
    name: 'Automatización',
    icon: '🤖',
    skills: ['Scripts Python', 'PowerShell', 'Bash', 'Web Scraping', 'RPA'],
  },
  {
    name: 'Metodologías',
    icon: '📋',
    skills: ['Scrum', 'Agile', 'Clean Code', 'SOLID', 'TDD', 'Buenas prácticas'],
  },
];
---

<section id="habilidades" class="py-24 relative">
  <!-- Background -->
  <div class="absolute inset-0 bg-bg-card/30"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <p class="text-primary font-medium mb-2" data-i18n="skills.badge">Habilidades</p>
      <h2 class="section-title" data-i18n="skills.title">Tecnologías y herramientas</h2>
      <p class="section-subtitle mx-auto" data-i18n="skills.subtitle">
        Un conjunto de tecnologías que domino para construir soluciones completas y de calidad
      </p>
    </div>

    <!-- Skills Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        skillCategories.map((category) => (
          <div class="card group">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-2xl">{category.icon}</span>
              <h3 class="text-lg font-semibold text-text-primary">{category.name}</h3>
            </div>
            <div class="flex flex-wrap gap-2">
              {category.skills.map((skill) => (
                <span class="tag">{skill}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
