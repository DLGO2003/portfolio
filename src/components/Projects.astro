---
const projects = [
  {
    title: 'Portafolio Personal',
    description:
      'Portafolio personal desarrollado con Astro, mostrando proyectos, experiencia y habilidades de manera profesional y atractiva, desplegado en Coolify mediante una VPS',
    tags: ['Astro', 'Coolify', 'VPS', 'CSS'],
    github: 'https://github.com/DLGO2003/portfolio',
    demo: 'https://portfolio-daniel.homelabvps.dev/',
    featured: true,
  },
  {
    title: 'Sistema de Automatización',
    description:
      'Herramienta de automatización de procesos que optimiza flujos de trabajo repetitivos, reduciendo tiempos de ejecución en un 70%.',
    tags: ['Python', 'Automation', 'APIs', 'Scripts'],
    github: 'https://github.com/DLGO2003',
    demo: '#',
    featured: true,
  },
  {
    title: 'API REST Escalable',
    description:
      'API robusta y bien documentada con autenticación JWT, rate limiting, logging y despliegue automatizado con CI/CD.',
    tags: ['Node.js', 'Express', 'MongoDB', 'JWT'],
    github: 'https://github.com/DLGO2003',
    demo: '#',
    featured: true,
  },
  {
    title: 'Dashboard de Analítica',
    description:
      'Panel de control interactivo con visualización de datos en tiempo real, gráficos dinámicos y exportación de reportes.',
    tags: ['React', 'Chart.js', 'REST API', 'Tailwind'],
    github: 'https://github.com/DLGO2003',
    demo: '#',
    featured: false,
  },
  {
    title: 'Landing Page Corporativa',
    description:
      'Sitio web moderno y responsive con animaciones, optimización SEO y tiempos de carga optimizados.',
    tags: ['Astro', 'Tailwind CSS', 'SEO', 'Performance'],
    github: 'https://github.com/DLGO2003',
    demo: '#',
    featured: false,
  },
  {
    title: 'Bot de Automatización',
    description:
      'Bot inteligente para automatizar tareas administrativas, con integración a APIs externas y notificaciones.',
    tags: ['Python', 'Telegram API', 'Automation', 'SQLite'],
    github: 'https://github.com/DLGO2003',
    demo: '#',
    featured: false,
  },
];

const featuredProjects = projects.filter((p) => p.featured);
const otherProjects = projects.filter((p) => !p.featured);
---

<section id="proyectos" class="py-24 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <p class="text-primary font-medium mb-2" data-i18n="projects.badge">Proyectos</p>
      <h2 class="section-title" data-i18n="projects.title">Trabajos destacados</h2>
      <p class="section-subtitle mx-auto" data-i18n="projects.subtitle">
        Una selección de proyectos que reflejan mi experiencia y pasión por el desarrollo de software
      </p>
    </div>

    <!-- Featured Projects -->
    <div class="grid lg:grid-cols-2 gap-8 mb-12">
      {
        featuredProjects.map((project) => (
          <div class="card group overflow-hidden">
            <!-- Project Image -->
            <div class="relative h-48 bg-gradient-to-br from-primary/20 to-primary/10 rounded-lg mb-6 overflow-hidden">
              <div class="absolute inset-0 flex items-center justify-center">
                <svg class="w-16 h-16 text-primary/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              </div>
              <div class="absolute top-3 right-3">
                <span class="px-2 py-1 text-xs bg-primary text-bg-dark rounded-full font-medium" data-i18n="projects.featured">Destacado</span>
              </div>
            </div>

            <!-- Project Info -->
            <h3 class="text-xl font-semibold text-text-primary mb-2 group-hover:text-primary-light transition-colors">
              {project.title}
            </h3>
            <p class="text-text-muted text-sm leading-relaxed mb-4">{project.description}</p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2 mb-6">
              {project.tags.map((tag) => (
                <span class="tag text-xs">{tag}</span>
              ))}
            </div>

            <!-- Links -->
            <div class="flex items-center gap-4">
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-text-secondary hover:text-primary transition-colors text-sm"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                </svg>
                <span data-i18n="projects.code">Código</span>
              </a>
              <a
                href={project.demo}
                class="inline-flex items-center gap-2 text-text-secondary hover:text-primary transition-colors text-sm"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                <span data-i18n="projects.demo">Demo</span>
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Other Projects -->
    <h3 class="text-xl font-semibold text-text-primary mb-6" data-i18n="projects.other">Otros proyectos</h3>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        otherProjects.map((project) => (
          <div class="card">
            <h4 class="text-lg font-semibold text-text-primary mb-2">{project.title}</h4>
            <p class="text-text-muted text-sm leading-relaxed mb-4">{project.description}</p>
            <div class="flex flex-wrap gap-2 mb-4">
              {project.tags.map((tag) => (
                <span class="tag text-xs">{tag}</span>
              ))}
            </div>
            <a
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-primary hover:text-primary-light transition-colors text-sm"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
              <span data-i18n="projects.viewCode">Ver código</span>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
