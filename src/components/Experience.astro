---
const experiences = [
  {
    period: '2020 - 2020',
    role: 'Técnico de Sistemas',
    company: 'La Ofrenda S.A.S',
    location: 'Pereira, Colombia',
    description:
      'Apoyo de soluciones informaticas, mantenimiento de sistemas y asistencia técnica a usuarios, contribuyendo a la eficiencia operativa de la empresa.',
    achievements: [
      'Mantenimiento y optimización de sistemas internos',
      'Automatización de procesos que redujeron tiempos operativos',
      'Instalación y configuración de servidores, redes y equipos',
    ],
    technologies: ['Servidores', 'Redes', 'Computadores', 'Hardware'],
  },
  {
    period: '2021 - Actualidad',
    role: 'Líder / Representante Técnico',
    company: 'Tes LTDA',
    location: 'Pereira, Colombia',
    description:
      'Revisión, mantenimiento e instalación de impresoras',
    achievements: [
      'Mantenimiento y reparación de impresoras y equipos de oficina',
      'Instalación y configuración de impresoras en servidores y redes locales',
      'Análisis de problemas técnicos y soluciones efectivas en equipo',
    ],
    technologies: ['Líderazgo', 'Impresoras', 'Escáneres', 'Trabajo en Equipo'],
  },
  {
    period: '2022 - Actualidad',
    role: 'Desarrollador Full Stack',
    company: 'Proyectos Autónomos',
    location: 'Pereira, Colombia',
    description:
      'Desarrollo soluciones web para todo tipo de necesidades, desde aplicaciones de gestión hasta sitios web interactivos, utilizando tecnologías modernas y mejores prácticas de desarrollo.',
    achievements: [
      'Desarrollé un sitio web para una empresa local que aumentó su presencia en línea y mejoró la interacción con los clientes.',
      'Desarrollé un sistemas de tickets para una empresa de servicios, mejorando la eficiencia en la gestión de solicitudes y seguimiento de incidencias.',
      'Desarrollé un sistema de gestión de inventario para una tienda en línea, optimizando el control de stock y reduciendo errores en la logística.',
    ],
    technologies: ['PHP', 'Laravel', 'HTML', 'CSS', 'JavaScript', 'MySQL'],
  },
    {
    period: '2023 - Actualidad',
    role: 'Desarrollador de Software / Líder de Ingeniería',
    company: 'Tes LTDA',
    location: 'Pereira, Colombia',
    description:
      'Lider un equipo de tecnicos y desarrolladores, supervisando proyectos de desarrollo de software y asegurando la entrega de soluciones de alta calidad que cumplan con los requisitos del cliente.',
    achievements: [
      'Se desarrollaron e implementaron soluciones de software que mejoraron la eficiencia operativa de la empresa.',
      'Montaje de redes y servidores para optimizar la infraestructura tecnológica de la empresa.',
      'Implementación de prácticas de desarrollo ágil y metodologías de gestión de proyectos para mejorar la colaboración y la entrega de resultados.',
    ],
    technologies: ['PHP', 'Laravel', 'Servidores', 'Redes', 'Scrum', 'Cloud'],
  },
];
---

<section id="experiencia" class="py-24 relative">
  <!-- Background -->
  <div class="absolute inset-0 bg-bg-card/30"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <p class="text-primary font-medium mb-2" data-i18n="experience.badge">Experiencia</p>
      <h2 class="section-title" data-i18n="experience.title">Mi trayectoria profesional</h2>
      <p class="section-subtitle mx-auto" data-i18n="experience.subtitle">
        Un recorrido por los roles y proyectos que han moldeado mi carrera como ingeniero de software
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Timeline Line -->
      <div class="absolute left-0 md:left-1/2 top-0 bottom-0 w-px bg-border transform md:-translate-x-px"></div>

      <!-- Experience Items -->
      <div class="space-y-12">
        {
          experiences.map((exp, index) => (
            <div class={`relative flex flex-col md:flex-row ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>
              <!-- Timeline Dot -->
              <div class="absolute left-0 md:left-1/2 w-4 h-4 bg-primary rounded-full transform -translate-x-1/2 md:-translate-x-1/2 ring-4 ring-bg-dark mt-2"></div>

              <!-- Content -->
              <div class={`w-full md:w-1/2 ${index % 2 === 0 ? 'md:pl-12 md:text-right' : 'md:pr-12'}`}>
                <div class="card ml-6 md:ml-0">
                  <!-- Period -->
                  <span class="inline-block px-3 py-1 text-xs font-medium bg-primary/10 text-primary-light rounded-full mb-3">
                    {exp.period}
                  </span>

                  <!-- Role & Company -->
                  <h3 class="text-xl font-semibold text-text-primary mb-1">{exp.role}</h3>
                  <p class="text-primary font-medium mb-1">{exp.company}</p>
                  <p class="text-text-muted text-sm mb-4">{exp.location}</p>

                  <!-- Description -->
                  <p class="text-text-secondary text-sm leading-relaxed mb-4">{exp.description}</p>

                  <!-- Achievements -->
                  <div class="mb-4">
                    <h4 class="text-sm font-semibold text-text-primary mb-2" data-i18n="experience.achievements">Logros destacados:</h4>
                    <ul class={`space-y-1 ${index % 2 === 0 ? 'md:text-right' : ''}`}>
                      {exp.achievements.map((achievement) => (
                        <li class="text-text-muted text-sm flex items-start gap-2">
                          <span class="text-primary mt-0.5">▸</span>
                          {achievement}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- Technologies -->
                  <div class="flex flex-wrap gap-2">
                    {exp.technologies.map((tech) => (
                      <span class="tag text-xs">{tech}</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
